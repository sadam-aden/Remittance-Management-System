// Prisma schema for the Remittance Management System.
//
// Triggers, functions, sequences and the append-only guard on ledger_entries
// are NOT expressible in the Prisma schema language — they live in raw SQL
// inside prisma/migrations/*/migration.sql. See that folder's README block
// at the top of 0002_ledger_and_audit_triggers/migration.sql for the full
// design rationale (balance posting, audit logging, idempotency).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// NOTE: Prisma 7 no longer reads a connection `url` here. The CLI (migrate/studio)
// gets its URL from prisma.config.ts; the runtime PrismaClient gets its connection
// via an explicit driver adapter (@prisma/adapter-neon) — see src/lib/db.ts.
datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  cashier
}

enum TransactionStatus {
  pending
  completed
  cancelled
}

enum LedgerEntryType {
  income
  sent
}

enum LedgerDirection {
  credit
  debit
}

enum AuditAction {
  login
  logout
  create
  edit
  delete
  print
  export
}

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  passwordHash  String    @map("password_hash")
  role          UserRole  @default(admin)
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  accounts Account[]
  sessions Session[]
  profile  Profile?

  customersCreated     Customer[]          @relation("CustomerCreatedBy")
  beneficiariesCreated Beneficiary[]       @relation("BeneficiaryCreatedBy")
  incomeCreated        IncomeTransaction[] @relation("IncomeCreatedBy")
  incomeUpdated        IncomeTransaction[] @relation("IncomeUpdatedBy")
  sentProcessed        SentTransaction[]   @relation("SentProcessedBy")
  sentUpdated          SentTransaction[]   @relation("SentUpdatedBy")
  auditLogs            AuditLog[]

  @@map("users")
}

model Profile {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone     String?
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("profiles")
}

// --- Auth.js (NextAuth) adapter models — field names must match the adapter exactly ---

model Account {
  id                String  @id @default(uuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// --- Domain models ---

model Customer {
  id         String   @id @default(uuid())
  fullName   String   @map("full_name")
  phone      String?
  email      String?
  nationalId String?  @map("national_id")
  country    String?
  city       String?
  address    String?
  notes      String?
  createdBy  String?  @map("created_by")
  creator    User?    @relation("CustomerCreatedBy", fields: [createdBy], references: [id])
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  incomeTransactions IncomeTransaction[]
  sentTransactions   SentTransaction[]

  @@index([fullName])
  @@index([phone])
  @@map("customers")
}

model Currency {
  code      String   @id // ISO 4217, e.g. USD
  name      String
  symbol    String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  ratesAsBase  ExchangeRate[] @relation("BaseCurrency")
  ratesAsQuote ExchangeRate[] @relation("QuoteCurrency")

  @@map("currencies")
}

// Reference table only — used to default form values. Historical transactions
// snapshot their own rate and never join back to this table (see sent_transactions.exchangeRate).
model ExchangeRate {
  id            String   @id @default(uuid())
  baseCurrency  String   @map("base_currency")
  base          Currency @relation("BaseCurrency", fields: [baseCurrency], references: [code])
  quoteCurrency String   @map("quote_currency")
  quote         Currency @relation("QuoteCurrency", fields: [quoteCurrency], references: [code])
  rate          Decimal  @db.Decimal(18, 6)
  effectiveDate DateTime @default(now()) @map("effective_date")
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([baseCurrency, quoteCurrency, effectiveDate])
  @@map("exchange_rates")
}

model IncomeTransaction {
  id                String            @id @default(uuid())
  // Generated by a BEFORE INSERT trigger from a DB sequence (INC-000123).
  // dbgenerated() marks this optional in Prisma Client's create input.
  transactionNumber String            @unique @default(dbgenerated()) @map("transaction_number")
  date              DateTime          @default(now())
  customerId        String            @map("customer_id")
  customer          Customer          @relation(fields: [customerId], references: [id])
  amount            Decimal           @db.Decimal(18, 2)
  currency          String
  paymentMethod     String            @map("payment_method")
  referenceNumber   String?           @map("reference_number")
  notes             String?
  status            TransactionStatus @default(pending)
  // Client-generated UUID; unique constraint rejects duplicate double-click submits.
  idempotencyKey    String?           @unique @map("idempotency_key")
  createdBy         String?           @map("created_by")
  creator           User?             @relation("IncomeCreatedBy", fields: [createdBy], references: [id])
  updatedBy         String?           @map("updated_by")
  updater           User?             @relation("IncomeUpdatedBy", fields: [updatedBy], references: [id])
  ipAddress         String?           @map("ip_address")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  @@index([status])
  @@index([date])
  @@index([customerId])
  @@map("income_transactions")
}

model SentTransaction {
  id                String            @id @default(uuid())
  transactionNumber String            @unique @default(dbgenerated()) @map("transaction_number")
  date              DateTime          @default(now())
  // The paying customer at the counter — mirrors income_transactions.customerId
  // so a customer's history spans both money they sent in and money sent out
  // on their behalf.
  customerId        String            @map("customer_id")
  customer          Customer          @relation(fields: [customerId], references: [id])
  // The returning-beneficiary lookup: every sent transaction links to a
  // Beneficiary profile (matched by phone/name search, or newly registered
  // on the spot when no match exists). recipientName/Phone/country/city below
  // stay as a point-in-time SNAPSHOT on the transaction (same rationale as
  // exchangeRate) — editing them here never mutates the beneficiary profile.
  beneficiaryId     String            @map("beneficiary_id")
  beneficiary       Beneficiary       @relation(fields: [beneficiaryId], references: [id])
  recipientName     String            @map("recipient_name")
  recipientPhone    String?           @map("recipient_phone")
  country           String?
  city              String?
  amount            Decimal           @db.Decimal(18, 2)
  currency          String
  transferFee       Decimal           @default(0) @map("transfer_fee") @db.Decimal(18, 2)
  // Snapshotted at creation time — never recomputed from exchange_rates later.
  exchangeRate      Decimal           @map("exchange_rate") @db.Decimal(18, 6)
  totalPaid         Decimal           @map("total_paid") @db.Decimal(18, 2)
  paymentMethod     String            @map("payment_method")
  status            TransactionStatus @default(pending)
  notes             String?
  // Photo/scan attached at creation time (e.g. a physical receipt or ID),
  // uploaded to Cloudflare R2 — see src/lib/r2.ts. Optional: R2 may not be
  // configured (e.g. local dev), in which case this simply stays null.
  receiptImageUrl   String?           @map("receipt_image_url")
  idempotencyKey    String?           @unique @map("idempotency_key")
  processedBy       String?           @map("processed_by")
  processor         User?             @relation("SentProcessedBy", fields: [processedBy], references: [id])
  updatedBy         String?           @map("updated_by")
  updater           User?             @relation("SentUpdatedBy", fields: [updatedBy], references: [id])
  ipAddress         String?           @map("ip_address")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  @@index([status])
  @@index([date])
  @@index([customerId])
  @@index([beneficiaryId])
  @@map("sent_transactions")
}

// A returning recipient's profile — looked up by phone or name when
// recording a new Sent Money transaction so a repeat beneficiary's details
// don't need to be re-typed. One profile, many transactions over time.
model Beneficiary {
  id        String   @id @default(uuid())
  fullName  String   @map("full_name")
  phone     String?
  country   String?
  city      String?
  notes     String?
  createdBy String?  @map("created_by")
  creator   User?    @relation("BeneficiaryCreatedBy", fields: [createdBy], references: [id])
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sentTransactions SentTransaction[]

  @@index([fullName])
  @@index([phone])
  @@map("beneficiaries")
}

// Append-only. UPDATE/DELETE are blocked at the DB level by a trigger
// (see migration 0002) — this is not just an app-level convention.
model LedgerEntry {
  id             String          @id @default(uuid())
  // Monotonic ordering key backing get_current_balance()'s O(1) "latest row" lookup.
  // created_at alone is not safe to sort by under concurrent inserts with equal timestamps.
  entrySeq       BigInt          @unique @default(autoincrement()) @map("entry_seq")
  entryType      LedgerEntryType @map("entry_type")
  referenceTable String          @map("reference_table")
  // Polymorphic pointer into income_transactions or sent_transactions depending
  // on reference_table/entry_type — cannot be a single Prisma relation/FK.
  referenceId    String          @map("reference_id")
  amount         Decimal         @db.Decimal(18, 2)
  direction      LedgerDirection
  balanceAfter   Decimal         @map("balance_after") @db.Decimal(18, 2)
  createdAt      DateTime        @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("ledger_entries")
}

model AuditLog {
  id        String      @id @default(uuid())
  userId    String?     @map("user_id")
  user      User?       @relation(fields: [userId], references: [id])
  action    AuditAction
  tableName String      @map("table_name")
  recordId  String?     @map("record_id")
  oldData   Json?       @map("old_data")
  newData   Json?       @map("new_data")
  ipAddress String?     @map("ip_address")
  createdAt DateTime    @default(now()) @map("created_at")

  @@index([tableName])
  @@index([createdAt])
  @@map("audit_logs")
}

model Settings {
  id              String   @id @default("default")
  companyName     String   @default("Remittance Co.") @map("company_name")
  logoUrl         String?  @map("logo_url")
  defaultCurrency String   @default("USD") @map("default_currency")
  receiptFooter   String?  @map("receipt_footer")
  businessAddress String?  @map("business_address")
  phoneNumbers    String?  @map("phone_numbers")
  taxSettings     Json?    @map("tax_settings")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("settings")
}
