# --- Database (Neon Postgres) ---
# Pooled connection (PgBouncer, "-pooler" host) — used by the app at runtime.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/remittance?sslmode=require"
# Direct (unpooled) connection — used by Prisma Migrate/Studio only.
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/remittance?sslmode=require"

# --- Auth.js ---
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-32-byte-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# --- Cloudflare R2 (S3-compatible object storage) ---
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="remittance-files"
# https://<accountid>.r2.cloudflarestorage.com
R2_ENDPOINT="https://your-cloudflare-account-id.r2.cloudflarestorage.com"
# Public bucket URL or custom domain used to build file links returned to the browser.
R2_PUBLIC_URL="https://files.example.com"
